{
  "name": "@goodandready/dsh-goal",
  "version": "0.2.21",
  "description": "Core Goal Addon (Token Budget, Milestones, Git Snapshots & Retrospective Reports) for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "README.md",
    "README.ru.md",
    "README.zh.md",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "scripts": {
    "test": "NODE_ENV=test node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "goal-mode",
    "autonomous-agent",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GooDAnDReaDY/dsh-goal.git"
  },
  "homepage": "https://github.com/GooDAnDReaDY/dsh-goal",
  "bugs": {
    "url": "https://github.com/GooDAnDReaDY/dsh-goal/issues"
  },
  "author": "goodandready",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-goal": "^0.1.7-rc.2 || ^0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-goal": {
      "optional": true
    }
  }
}
